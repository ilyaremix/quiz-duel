// Схема базы Quiz Duel. Этап 1: игроки. Этап 2: вопросы. Этап 4: партии, ответы, согласия.
// Этап 7: итоги партии (рейтинг, статистика по категориям, ачивки). Этап 8: тренировки.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum LangSetting {
  auto
  ru
  en
}

enum ThemeSetting {
  auto
  light
  dark
}

enum MotionSetting {
  auto
  on
  off
}

model User {
  /// Telegram user id (до 52 бит, поэтому BigInt)
  id            BigInt        @id
  firstName     String        @map("first_name")
  lastName      String?       @map("last_name")
  username      String?
  photoUrl      String?       @map("photo_url")
  /// language_code из Telegram, нужен для «Авто»
  tgLanguage    String?       @map("tg_language")
  isPremium     Boolean       @default(false) @map("is_premium")

  language      LangSetting   @default(auto)
  reducedMotion MotionSetting @default(auto) @map("reduced_motion")
  haptics       Boolean       @default(true)
  notifications Boolean       @default(true)
  /// Разрешил ли игрок боту писать ему (requestWriteAccess)
  writeAccess   Boolean       @default(false) @map("write_access")
  /// Последняя принятая версия документов (дополнение к ТЗ о согласии)
  docsVersion   String?       @map("docs_version")
  /// Смотрел слайды онбординга (пришедший по ссылке видит их после партии)
  onboarded     Boolean       @default(false)
  /// Обновление 2.0: тема оформления (auto - как в Telegram)
  theme         ThemeSetting  @default(auto)

  /// Монеты: тратятся на оформление и темы. Каждое изменение - строка в coin_ledger
  coins         Int           @default(0)
  /// Куплено «Без рекламы» за звёзды
  adFree        Boolean       @default(false) @map("ad_free")
  /// Надетое свечение аватарки и набор реакций (купленные - в inventory)
  glow          String        @default("none")
  reactionPack  String        @default("base") @map("reaction_pack")
  /// Серия входа: день последней награды (YYYY-MM-DD по Москве) и длина серии
  streakDay     String?       @map("streak_day")
  streakCount   Int           @default(0) @map("streak_count")
  /// Партий с последней обязательной рекламы (после каждой 3-й - ролик)
  gamesSinceAd  Int           @default(0) @map("games_since_ad")
  /// Откуда пришёл: первый start_param (src_..., r_..., g_...) или inline/organic
  source        String?
  /// Кто пригласил (r_<id>) и выдана ли награда за его первую партию
  referrerId    BigInt?       @map("referrer_id")
  refRewarded   Boolean       @default(false) @map("ref_rewarded")
  /// Заблокирован в админке: не может играть
  banned        Boolean       @default(false)

  rating        Int           @default(1000)
  games         Int           @default(0)
  wins          Int           @default(0)
  losses        Int           @default(0)
  draws         Int           @default(0)
  currentStreak Int           @default(0) @map("current_streak")
  bestStreak    Int           @default(0) @map("best_streak")
  /// Верных ответов всего: дуэли + тренировки (для ачивки «Эрудит»)
  totalCorrect  Int           @default(0) @map("total_correct")
  /// Сыгранных (закрытых) вопросов в рейтинговых дуэлях - знаменатель точности
  questionsPlayed Int         @default(0) @map("questions_played")
  /// Верных ответов в рейтинговых дуэлях - числитель точности
  duelCorrect   Int           @default(0) @map("duel_correct")
  /// Сумма времени верных ответов дуэлей (мс) - для «среднего времени верного ответа»
  correctTimeMs BigInt        @default(0) @map("correct_time_ms")

  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")
  lastSeenAt    DateTime      @default(now()) @map("last_seen_at")

  gamesCreated  Game[]        @relation("GameCreator")
  gamesJoined   Game[]        @relation("GameOpponent")
  answers       Answer[]
  consents      Consent[]
  categoryStats CategoryStat[]
  achievements  UserAchievement[]
  soloRuns      SoloRun[]
  coinTxs       CoinTx[]
  owned         Owned[]
  taskProgress  TaskProgress[]
  purchases     Purchase[]
  adViews       AdView[]
  topicPasses   TopicPass[]
  friendsOut    Friend[]      @relation("FriendFrom")
  friendsIn     Friend[]      @relation("FriendTo")
  days          UserDay[]

  @@index([rating(sort: Desc)])
  @@index([referrerId])
  @@map("users")
}

enum Category {
  science
  history
  culture
  sport
  tech
  /// Обновление 2.0: платные темы
  games
  space
  food
  crypto
}

enum Difficulty {
  easy
  medium
  hard
}

/// Вопросы. Источник - data/questions.json: сервер при старте синхронизирует таблицу с файлом.
/// Таблица нужна, чтобы партии и ответы ссылались на вопросы внешними ключами
/// и чтобы разбор старой партии показывал её вопросы, даже если файл потом изменился.
model Question {
  /// sci-01 … tec-20
  id           String     @id
  category     Category
  difficulty   Difficulty
  textRu       String     @map("text_ru")
  textEn       String     @map("text_en")
  optionsRu    String[]   @map("options_ru")
  optionsEn    String[]   @map("options_en")
  /// Индекс верного варианта (0-3), общий для обоих языков
  correctIndex Int        @map("correct_index")
  /// false - вопрос убрали из файла; строку не удаляем, на неё могут ссылаться старые партии
  active       Boolean    @default(true)
  updatedAt    DateTime   @updatedAt @map("updated_at")
  answers      Answer[]

  @@index([category, difficulty])
  @@map("questions")
}

/// Категория партии: «Микс» или одна из пяти.
enum GameCategory {
  mix
  science
  history
  culture
  sport
  tech
  /// Обновление 2.0: платные темы
  games
  space
  food
  crypto
}

/// link - дуэль по ссылке, quick - быстрая игра, rematch - реванш, solo - тренировка
enum GameMode {
  link
  quick
  rematch
  solo
}

enum GamePhase {
  waiting
  lobby
  /// Обновление 2.0: «Микс» - выбор темы перед отсчётом
  draft
  countdown
  question
  reveal
  finished
  expired
  cancelled
}

enum FinishReason {
  completed
  forfeit
  abandoned
}

enum CancelReason {
  creator
  left
  no_answers
}

/// Партия. Сервер держит активные партии в памяти и пишет сюда каждую смену состояния.
/// Колонки - для запросов (история, «что видели игроки», восстановление),
/// snapshot - полное состояние машины, из него партия поднимается после перезапуска.
model Game {
  /// 10 случайных символов [A-Za-z0-9], они же в ссылке startapp=g_<id>
  id                   String        @id @db.VarChar(10)
  mode                 GameMode
  phase                GamePhase
  finishReason         FinishReason? @map("finish_reason")
  cancelReason         CancelReason? @map("cancel_reason")
  category             GameCategory
  creatorId            BigInt        @map("creator_id")
  opponentId           BigInt?       @map("opponent_id")
  /// 10 вопросов партии по порядку (пусто до старта отсчёта)
  questionIds          String[]      @map("question_ids")
  /// Порядок вариантов на экране для каждого вопроса: [[2,0,3,1], …]
  optionOrders         Json          @default("[]") @map("option_orders")
  /// -1 до первого вопроса
  questionIndex        Int           @default(-1) @map("question_index")
  phaseEndsAt          DateTime?     @map("phase_ends_at")
  lobbyExpiresAt       DateTime?     @map("lobby_expires_at")
  creatorScore         Int           @default(0) @map("creator_score")
  opponentScore        Int           @default(0) @map("opponent_score")
  winnerId             BigInt?       @map("winner_id")
  /// Рейтинг до партии и изменение - заполняются на этапе 7 при подсчёте итогов
  creatorRatingBefore  Int?          @map("creator_rating_before")
  creatorRatingDelta   Int?          @map("creator_rating_delta")
  opponentRatingBefore Int?          @map("opponent_rating_before")
  opponentRatingDelta  Int?          @map("opponent_rating_delta")
  rematchOf            String?       @map("rematch_of") @db.VarChar(10)
  /// Обновление 2.0: режим (classic, lives, sudden, final), секунд на ответ, вопросов
  variant              String        @default("classic")
  timeSec              Int           @default(15) @map("time_sec")
  questionCount        Int           @default(10) @map("question_count")
  rev                  Int
  snapshot             Json
  createdAt            DateTime      @default(now()) @map("created_at")
  startedAt            DateTime?     @map("started_at")
  finishedAt           DateTime?     @map("finished_at")
  /// Когда посчитаны итоги (рейтинг, статистика, ачивки). Завершённая рейтинговая партия
  /// с пустым полем досчитывается при старте сервера; повторный подсчёт ничего не меняет.
  settledAt            DateTime?     @map("settled_at")
  updatedAt            DateTime      @updatedAt @map("updated_at")

  creator  User     @relation("GameCreator", fields: [creatorId], references: [id])
  opponent User?    @relation("GameOpponent", fields: [opponentId], references: [id])
  answers  Answer[]
  soloRun  SoloRun?

  @@index([phase])
  @@index([creatorId, createdAt(sort: Desc)])
  @@index([opponentId, createdAt(sort: Desc)])
  @@index([creatorId, finishedAt(sort: Desc)])
  @@index([opponentId, finishedAt(sort: Desc)])
  @@map("games")
}

/// Ответ игрока на вопрос. Уникальный индекс - вторая линия защиты от двойного ответа.
model Answer {
  id            BigInt   @id @default(autoincrement())
  gameId        String   @map("game_id") @db.VarChar(10)
  userId        BigInt   @map("user_id")
  questionIndex Int      @map("question_index")
  questionId    String   @map("question_id")
  /// Индекс варианта в базе (общий для RU и EN)
  optionIndex   Int      @map("option_index")
  /// Позиция, которую игрок нажал на экране
  position      Int
  isCorrect     Boolean  @map("is_correct")
  timeMs        Int      @map("time_ms")
  points        Int
  createdAt     DateTime @default(now()) @map("created_at")

  game     Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id])
  question Question @relation(fields: [questionId], references: [id])

  @@unique([gameId, userId, questionIndex])
  @@index([userId])
  @@map("answers")
}

/// terms - Пользовательское соглашение, privacy - Политика конфиденциальности,
/// pd_consent - отдельное согласие на обработку ПД (если юрист скажет, что оно нужно)
enum ConsentDoc {
  terms
  privacy
  pd_consent
}

/// Журнал принятия документов: строки только добавляются, не меняются и не удаляются.
model Consent {
  id         BigInt     @id @default(autoincrement())
  userId     BigInt     @map("user_id")
  doc        ConsentDoc
  docVersion String     @map("doc_version")
  /// Время сервера (UTC), не клиента
  acceptedAt DateTime   @default(now()) @map("accepted_at")
  /// Первый адрес из X-Forwarded-For, который выставляет Caddy
  ip         String?
  userAgent  String?    @map("user_agent")

  user User @relation(fields: [userId], references: [id])

  @@index([userId, doc, docVersion])
  @@map("consents")
}

/// Статистика игрока по категориям рейтинговых дуэлей.
/// answered / correct - по теме самого вопроса (в «Миксе» у каждого вопроса своя),
/// wins - по категории партии («Микс» не категория и сюда не входит).
model CategoryStat {
  userId   BigInt   @map("user_id")
  category Category
  answered Int      @default(0)
  correct  Int      @default(0)
  wins     Int      @default(0)

  user User @relation(fields: [userId], references: [id])

  @@id([userId, category])
  @@map("category_stats")
}

/// Полученные ачивки. Выдаются сервером в той же транзакции, что и рейтинг.
model UserAchievement {
  userId     BigInt   @map("user_id")
  /// Код из packages/shared/src/achievements.ts
  code       String   @db.VarChar(32)
  /// Партия, в которой получена
  gameId     String?  @map("game_id") @db.VarChar(10)
  unlockedAt DateTime @default(now()) @map("unlocked_at")

  user User @relation(fields: [userId], references: [id])

  @@id([userId, code])
  @@map("user_achievements")
}

/// Тренировка (одиночная партия): одна строка на доигранную попытку. Рейтинг не трогает;
/// лучший счёт по категории - личный рекорд. Верные ответы идут только в «Эрудита».
model SoloRun {
  /// Партия тренировки (mode = solo) - одна строка на партию, повторный подсчёт ничего не добавит
  gameId    String       @id @map("game_id") @db.VarChar(10)
  userId    BigInt       @map("user_id")
  category  GameCategory
  score     Int
  correct   Int
  createdAt DateTime     @default(now()) @map("created_at")

  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id])

  @@index([userId, category, score(sort: Desc)])
  @@map("solo_runs")
}

// ---------------------------------------------------------------------------
// Обновление 2.0: монеты, магазин, реклама, друзья, аналитика

/// Журнал монет: любое начисление и списание. key - защита от повтора (одна награда - одна строка)
model CoinTx {
  id        BigInt   @id @default(autoincrement())
  userId    BigInt   @map("user_id")
  delta     Int
  /// Баланс после операции
  balance   Int
  /// daily, task, ad, buy, stars, invite, friend, admin, refund
  reason    String
  /// Что именно: id задания, товар, id платежа
  ref       String?
  key       String?  @unique
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([reason, createdAt])
  @@map("coin_ledger")
}

/// Купленное: свечения (glow), наборы реакций (pack), темы навсегда (topic)
model Owned {
  userId    BigInt   @map("user_id")
  kind      String
  item      String
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, kind, item])
  @@index([kind, item])
  @@map("inventory")
}

/// Задания магазина. Настраиваются в админке; при первом запуске создаются из DEFAULT_TASKS
model TaskConfig {
  id        String   @id @db.VarChar(32)
  /// channel, play, ads, story, invite
  type      String
  /// Для channel: @username канала
  channel   String?
  /// Сколько нужно (play - партий за день, ads - роликов за день)
  goal      Int      @default(1)
  reward    Int
  /// once, daily, perFriend
  freq      String
  on        Boolean  @default(true)
  sort      Int      @default(0)
  /// Свой заголовок из админки (пусто - стандартный текст приложения)
  titleRu   String?  @map("title_ru")
  titleEn   String?  @map("title_en")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  progress TaskProgress[]

  @@map("tasks")
}

/// Прогресс игрока по заданию: day - день (YYYY-MM-DD по Москве) для ежедневных, '' для разовых
model TaskProgress {
  userId    BigInt    @map("user_id")
  taskId    String    @map("task_id") @db.VarChar(32)
  day       String    @db.VarChar(10)
  count     Int       @default(0)
  claimedAt DateTime? @map("claimed_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  user User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  task TaskConfig @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@id([userId, taskId, day])
  @@index([taskId, claimedAt])
  @@map("task_progress")
}

/// Покупки за звёзды. id - telegram_payment_charge_id (повторное уведомление ничего не начислит)
model Purchase {
  id         String    @id
  userId     BigInt    @map("user_id")
  /// coins_s, coins_m, coins_l, adfree
  product    String
  stars      Int
  createdAt  DateTime  @default(now()) @map("created_at")
  refundedAt DateTime? @map("refunded_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@map("purchases")
}

/// Просмотр рекламы: старт выдаёт сервер, засчитывается только досмотренный до конца
model AdView {
  id        String    @id @db.VarChar(32)
  userId    BigInt    @map("user_id")
  /// forced - после 3 партий, reward - за монеты, topic - тема на 1 игру
  purpose   String
  topic     String?
  startedAt DateTime  @map("started_at")
  doneAt    DateTime? @map("done_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, startedAt])
  @@index([startedAt])
  @@map("ad_views")
}

/// Тема на одну игру за просмотр рекламы
model TopicPass {
  id        BigInt    @id @default(autoincrement())
  userId    BigInt    @map("user_id")
  topic     String
  createdAt DateTime  @default(now()) @map("created_at")
  usedAt    DateTime? @map("used_at")
  gameId    String?   @map("game_id") @db.VarChar(10)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, topic, usedAt])
  @@map("topic_passes")
}

/// Друзья: pending - заявка от user к friend; accepted - дружба (по строке на каждого из двух)
model Friend {
  userId    BigInt   @map("user_id")
  friendId  BigInt   @map("friend_id")
  status    String
  /// ref - пришёл по ссылке-приглашению, request - заявка
  via       String   @default("request")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user   User @relation("FriendFrom", fields: [userId], references: [id], onDelete: Cascade)
  friend User @relation("FriendTo", fields: [friendId], references: [id], onDelete: Cascade)

  @@id([userId, friendId])
  @@index([friendId, status])
  @@map("friends")
}

/// События для админки: экраны и кнопки (без личных данных, только имя и игрок)
model Event {
  id        BigInt   @id @default(autoincrement())
  userId    BigInt?  @map("user_id")
  name      String   @db.VarChar(32)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([name, createdAt])
  @@index([userId, createdAt])
  @@map("events")
}

/// Дни, когда игрок открывал приложение: DAU, MAU, удержание, когорты
model UserDay {
  userId BigInt   @map("user_id")
  day    DateTime @db.Date

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, day])
  @@index([day])
  @@map("user_days")
}

/// Ссылки для рекламы приложения: t.me/<бот>/<app>?startapp=src_<code>
model Link {
  code      String   @id @db.VarChar(32)
  title     String
  createdAt DateTime @default(now()) @map("created_at")

  @@map("links")
}
