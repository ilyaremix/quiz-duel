# Скопируйте в .env и заполните. Файл .env в git не попадает.

# Токен бота от @BotFather. Им же проверяется подпись initData.
BOT_TOKEN=123456789:replace-me

# Короткое имя мини-аппа из /newapp в @BotFather (ссылка t.me/<бот>/<это имя>), например QuizDuel
APP_SHORT_NAME=replace-me

# Публичный адрес мини-аппа (HTTPS), тот же, что указан в @BotFather
WEB_APP_URL=https://quiz.example.com

# Пароль базы: только буквы и цифры, сгенерировать: openssl rand -hex 24
POSTGRES_PASSWORD=replace-me

# Порт, на котором контейнер web слушает 127.0.0.1 (к нему проксирует Caddy на сервере)
WEB_PORT=3080

# Незаполненные BOT_TOKEN и APP_SHORT_NAME сервер не примет и скажет, что не так.

# Необязательно
# LOG_LEVEL=info
# INIT_DATA_MAX_AGE_SEC=86400
# Без бота (локальная вёрстка без своего токена): карточки и уведомления выключены, игра работает
# BOT_ENABLED=false

# Версия Пользовательского соглашения и Политики конфиденциальности.
# Поменяли тексты - поменяйте версию: игроки снова увидят галочки.
# DOCS_VERSION=2026-11-07.2
# Адреса документов (по умолчанию - страницы в Telegraph, см. README «Документы»)
# TERMS_URL=https://...
# PRIVACY_URL=https://...

# Только для локальной разработки без Docker-сервера (npm run dev:server).
# В docker compose адрес базы собирается сам, эту строку он игнорирует.
# DATABASE_URL=postgresql://quizduel:<POSTGRES_PASSWORD>@127.0.0.1:5432/quizduel

# Автодеплой (deploy/autodeploy.sh): кому бот пишет об обновлениях сервера, Telegram id.
# Пусто - без уведомлений. install-autodeploy.sh заполняет его сам.
DEPLOY_NOTIFY_CHAT_ID=

# Сверка оплат звёздами: за сколько последних дней потерянный платёж зачисляется сам (по умолчанию 7).
# Более старые оплаты без зачисления бот присылает владельцу; проверив их, увеличьте число и перезапустите сервер.
# STARS_RECONCILE_DAYS=7

# Админка (Настройки → «Админка», команда /admin у бота): Telegram id через запятую.
# Пусто - админ тот же, кому идут уведомления о деплое (DEPLOY_NOTIFY_CHAT_ID).
ADMIN_IDS=
