# Скопируйте в .env и заполните. Файл .env в git не попадает.

# Токен бота от @BotFather. Им же проверяется подпись initData.
BOT_TOKEN=123456789:replace-me

# Короткое имя мини-аппа из /newapp в @BotFather (ссылка t.me/<бот>/<это имя>)
APP_SHORT_NAME=play

# Публичный адрес мини-аппа (HTTPS), тот же, что указан в @BotFather
WEB_APP_URL=https://quiz.aidcrypto.blog

# Пароль базы: только буквы и цифры, сгенерировать: openssl rand -hex 24
POSTGRES_PASSWORD=replace-me

# Порт, на котором контейнер web слушает 127.0.0.1 (к нему проксирует Caddy на сервере)
WEB_PORT=3080

# Необязательно
# LOG_LEVEL=info
# INIT_DATA_MAX_AGE_SEC=86400

# Только для локальной разработки без Docker-сервера (npm run dev:server).
# В docker compose адрес базы собирается сам, эту строку он игнорирует.
# DATABASE_URL=postgresql://quizduel:<POSTGRES_PASSWORD>@127.0.0.1:5432/quizduel

# Автодеплой (deploy/autodeploy.sh): кому бот пишет об обновлениях сервера, Telegram id.
# Пусто - без уведомлений. install-autodeploy.sh заполняет его сам.
DEPLOY_NOTIFY_CHAT_ID=
