{
  "name": "quiz-duel",
  "version": "0.1.0",
  "private": true,
  "description": "Quiz Duel - Telegram Mini App: real-time 1v1 quiz",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev:server": "npm run dev -w @quiz-duel/server",
    "dev:web": "npm run dev -w @quiz-duel/web",
    "db:generate": "npm run prisma:generate -w @quiz-duel/server",
    "db:migrate": "npm run prisma:migrate -w @quiz-duel/server",
    "db:seed": "npm run db:seed -w @quiz-duel/server",
    "build": "npm run build -w @quiz-duel/web && npm run build -w @quiz-duel/server",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.5.0",
    "prettier": "^3.9.10",
    "typescript-eslint": "^8.72.1"
  }
}
